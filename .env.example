# Copy this file to .env.local and fill in the values.
# Also add the same variables in Netlify → Site configuration → Environment variables.

# Supabase → Project Settings → API (Project URL and the "anon public" key).
# The anon key is safe to expose in the browser; data is protected by Row Level Security.
# Never assign a secret or service_role key to a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials for Admin → Users → Invite.
# Use a Supabase secret key or set SUPABASE_SERVICE_ROLE_KEY for a legacy key.
# Add the invitation redirect URL (ending in /reset-password) to Supabase Auth's redirect allow list.
SUPABASE_SECRET_KEY=
SUPABASE_INVITE_REDIRECT_URL=

# Google reviews on the homepage (server-only — no NEXT_PUBLIC_ prefix).
# Google Cloud → enable "Places API (New)" → create an API key restricted to that API.
# GOOGLE_PLACE_ID is the business's Place ID (find it with Google's Place ID Finder).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Bank transfer details shown on the course purchase page.
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_PROMPTPAY=
